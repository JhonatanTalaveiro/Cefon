---
import { clinica, linkWhatsapp } from '../../data/clinica';
import { grupos } from '../../data/servicos';
import Button from '../Button.astro';
import Icon from '../Icon.astro';

const tons = [
  { tint: 'var(--color-brand-sky)', ink: 'var(--color-sky-ink)' },
  { tint: 'var(--color-brand-green)', ink: 'var(--color-green-ink)' },
  { tint: 'var(--color-brand-yellow)', ink: 'var(--color-amber-ink)' },
  { tint: 'var(--color-brand-coral)', ink: 'var(--color-coral-ink)' },
];
const pontos = ['var(--color-brand-sky)', 'var(--color-brand-coral)'];
const whatsapp = linkWhatsapp();
---

<section id="servicos" class="relative isolate overflow-hidden bg-sand py-20 lg:py-32" aria-labelledby="titulo-servicos">
  <div aria-hidden="true" class="pointer-events-none absolute -top-32 -right-40 -z-10 size-[30rem] rounded-full bg-[radial-gradient(closest-side,rgb(144_204_240/0.35),transparent)]" data-parallax="-30"></div>

  <div class="container-site">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="mini-titulo">Exames e serviços</p>
        <h2 id="titulo-servicos" class="mt-3 text-4xl leading-[1.1] font-medium sm:text-5xl">
          O que fazemos, explicado de forma simples
        </h2>
      </div>
      <p class="text-lg sm:text-xl lg:col-span-5">
        Um resumo do nosso trabalho. Se tiver dúvida sobre qual é o seu caso, ligue: a gente orienta.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:mt-16 lg:grid-cols-2">
      {grupos.map((grupo, g) => (
        <div class="rounded-[2rem] bg-white p-6 sm:p-9" data-reveal>
          <div class="border-b border-line pb-5">
            <h3 class="flex items-center gap-3 text-2xl font-medium sm:text-3xl">
              <span class="size-3 rounded-full" style={`background:${pontos[g % pontos.length]}`} aria-hidden="true"></span>
              {grupo.titulo}
            </h3>
            <p class="mt-2 text-base text-muted">{grupo.descricao}</p>
          </div>
          <ul class="divide-y divide-line">
            {grupo.itens.map((item, i) => {
              const tom = tons[(i + g * 2) % tons.length];
              return (
                <li class="flex gap-4 py-5 last:pb-0">
                  <span class="icon-bubble shrink-0" style={`--tint:${tom.tint};--ink:${tom.ink}`}>
                    <Icon name={item.icone} class="size-6" />
                  </span>
                  <div>
                    <h4 class="text-lg font-semibold sm:text-xl">{item.nome}</h4>
                    <p class="mt-1 text-base sm:text-[1.0625rem]">{item.descricao}</p>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>

    <div class="relative isolate mt-6 overflow-hidden rounded-[2rem] bg-ink px-6 py-10 text-white/80 sm:px-10 sm:py-12 lg:flex lg:items-center lg:justify-between lg:gap-10" data-reveal>
      <div aria-hidden="true" class="pointer-events-none absolute -top-28 -right-28 -z-10 hidden size-64 lg:block">
        <span class="absolute top-0 left-0 size-40 rounded-full bg-brand-yellow/85"></span>
        <span class="absolute top-16 left-20 size-40 rounded-full bg-brand-coral/80"></span>
        <span class="absolute top-20 left-0 size-36 rounded-full bg-brand-sky/75"></span>
      </div>
      <div class="max-w-xl">
        <h3 class="text-2xl font-medium text-white sm:text-3xl">Não sabe por onde começar?</h3>
        <p class="mt-3 text-lg">Ligue e conte o que está acontecendo. A gente explica qual exame ou atendimento procurar e marca um horário.</p>
      </div>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:mt-0 lg:mr-28 lg:shrink-0">
        <Button href={clinica.telefone.link} variant="yellow" icon="phone" detalhe={clinica.telefone.exibicao}>
          Ligar e tirar dúvidas
        </Button>
        {whatsapp && (
          <Button href={whatsapp} variant="outline-light" icon="chat" external detalhe={clinica.whatsapp!.exibicao}>
            Conversar no WhatsApp
          </Button>
        )}
      </div>
    </div>
  </div>
</section>
